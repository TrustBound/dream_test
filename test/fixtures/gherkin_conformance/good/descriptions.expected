feature "Descriptions everywhere"
  description "  This is a single line description"
  scenario "Scenario" "two lines"
    description "  This description\n  has two lines and indented with two spaces"
    step "Given" "the minimalism"
  scenario "Scenario" "without indentation"
    description "This is a description without indentation"
    step "Given" "the minimalism"
  scenario "Scenario" "empty lines in the middle"
    description "  This description\n\n  has an empty line in the middle"
    step "Given" "the minimalism"
  scenario "Scenario" "empty lines around"
    description "  This description\n  has an empty lines around"
    step "Given" "the minimalism"
  scenario "Scenario" "comment after description"
    description "  This description\n  has a comment after"
    step "Given" "the minimalism"
  scenario "Scenario" "comment right after description"
    description "  This description\n  has a comment right after"
    step "Given" "the minimalism"
  scenario "Scenario" "description with escaped docstring separator"
    description "  This description has an \\\"\\\"\\\" (escaped docstring sparator)"
    step "Given" "the minimalism"
  scenario "Scenario Outline" "scenario outline with a description"
    description "This is a scenario outline description"
    step "Given" "the minimalism"
    examples "examples with description"
      description "This is an examples description"
      header "foo"
      row "bar"
