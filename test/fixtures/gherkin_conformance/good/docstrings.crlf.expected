feature "DocString variations"
  scenario "Scenario" "minimalistic"
    step "Given" "a simple DocString"
      docstring none "first line (no indent)\n  second line (indented with two spaces)\n\nthird line was empty"
    step "Given" "a DocString with content type"
      docstring "xml" "<foo>\n  <bar />\n</foo>"
    step "And" "a DocString with wrong indentation"
      docstring none "wrongly indented line"
    step "And" "a DocString with alternative separator"
      docstring none "first line\nsecond line"
    step "And" "a DocString with normal separator inside"
      docstring none "first line\n\"\"\"\nthird line"
    step "And" "a DocString with alternative separator inside"
      docstring none "first line\n```\nthird line"
    step "And" "a DocString with escaped separator inside"
      docstring none "first line\n\"\"\"\nthird line"
    step "And" "a DocString with an escaped alternative separator inside"
      docstring none "first line\n```\nthird line"
