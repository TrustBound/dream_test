feature "Descriptions with comments everywhere"
  description "  This is a description\n  with a comment in the middle and at the end"
  scenario "Scenario" "two lines"
    description "  This description\n  has two lines and two comments in the middle and is indented with two spaces"
    step "Given" "the minimalism"
  scenario "Scenario" "without indentation"
    description "This is a description without indentation\nand a comment in the middle and at the end"
    step "Given" "the minimalism"
  scenario "Scenario" "empty lines in the middle"
    description "  This description\n\n  has an empty line and a comment in the middle"
    step "Given" "the minimalism"
  scenario "Scenario" "empty lines around"
    description "  This description\n  has an empty lines around"
    step "Given" "the minimalism"
  scenario "Scenario Outline" "scenario outline with a description"
    description "This is a scenario outline description with comments\nin the middle and before and at the end"
    step "Given" "the minimalism"
    examples "examples with description"
      description "This is an examples description\nwith a comment in the middle"
      header "foo"
      row "bar"
  scenario "Scenario" "scenario with just a comment"
    step "Given" "the minimalism"
  scenario "Scenario" "scenario with a comment with new lines around"
    step "Given" "the minimalism"
